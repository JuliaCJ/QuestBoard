generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String           @id @default(cuid())
  username          String           @unique
  passwordHash      String
  role              String           @default("player")
  displayName       String
  hasPriority       Boolean          @default(false)
  priorityUntil     DateTime?
  renown            Int              @default(0)
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  ownedItems        OwnedItem[]
  signups           Signup[]
  ledger            Ledger[]
  keys              PriorityKey[]
  achievements      UserAchievement[]
}

model Quest {
  id               String   @id @default(cuid())
  title            String
  level            Int      @default(1)
  description      String   @default("")
  renownReward     Int      @default(0)
  oneShotDate      DateTime
  minPlayers       Int      @default(3)
  maxPlayers       Int      @default(6)
  postAt           DateTime
  prioritySignupAt DateTime
  generalSignupAt  DateTime
  manualLock       Boolean  @default(false)
  status           String   @default("active") // active | postponed | completed | cancelled
  createdAt        DateTime @default(now())
  signups          Signup[]
}

model Signup {
  id        String   @id @default(cuid())
  questId   String
  userId    String
  className String   @default("Undecided")
  status    String   @default("signed_up") // signed_up | withdrawn | completed | no_show
  createdAt DateTime @default(now())
  quest     Quest    @relation(fields: [questId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([questId, userId])
}

model PriorityKey {
  id           String    @id @default(cuid())
  code         String    @unique
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  redeemedById String?
  redeemedAt   DateTime?
  redeemedBy   User?     @relation(fields: [redeemedById], references: [id])
}

model Ledger {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  reason    String // quest | bonus | first_quest | admin_adjust | store_purchase | achievement
  note      String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
}

model ItemLabel {
  id        String     @id @default(cuid())
  name      String     @unique
  createdAt DateTime   @default(now())
  items     ShopItem[]
}

model ShopItem {
  id          String     @id @default(cuid())
  name        String
  description String     @default("")
  price       Int
  type        String     @default("consumable") // "consumable" | "equipable"
  statSheet   String     @default("")
  isActive    Boolean    @default(true) // false = archived
  createdAt   DateTime   @default(now())
  labelId     String
  label       ItemLabel  @relation(fields: [labelId], references: [id], onDelete: Restrict)
  links       ItemLink[]
  image       ItemImage?
}

model ItemImage {
  id        String   @id @default(cuid())
  itemId    String   @unique
  item      ShopItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  mime      String
  data      Bytes
  createdAt DateTime @default(now())
}

model ItemLink {
  id        String   @id @default(cuid())
  itemId    String
  item      ShopItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  label     String
  url       String
  createdAt DateTime @default(now())

  @@index([itemId])
}

model OwnedItem {
  id          String    @id @default(cuid())
  userId      String
  name        String
  type        String    @default("consumable")
  purchasedAt DateTime  @default(now())
  usedAt      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Achievement {
  id              String            @id @default(cuid())
  name            String            @unique
  assignType      String            @default("Manual") // Automatic | Manual
  earnType        String            @default("Individual") // Individual | Team
  secret          Boolean           @default(false)
  description     String            @default("")
  reward          Int               @default(0)

  // Used by automatic achievements
  // completed_quests | renown_spent | completed_quest_party_size
  trigger         String?
  target          Int               @default(1)

  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  recipients      UserAchievement[]
}

model UserAchievement {
  id              String      @id @default(cuid())
  userId          String
  achievementId   String
  earnedAt        DateTime    @default(now())
  source          String      @default("automatic") // automatic | manual

  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement     Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  // Prevents a player from receiving the same achievement more than once
  @@unique([userId, achievementId])
  @@index([achievementId])
  @@index([userId])
}
